<Window x:Class="UISI_Doc_Constructor.ScreenRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{x:Null}" Title="Выберите область для распознавания"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Topmost="True" Background="Black" Cursor="Cross"
        KeyDown="Window_KeyDown" SourceInitialized="Window_SourceInitialized">
    <!-- A transparent background keeps the entire overlay hit-testable. All visual children ignore mouse input. -->
    <Grid x:Name="Surface" Background="Transparent" MouseLeftButtonDown="Surface_MouseDown"
          MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp">
        <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False" />
        <Path x:Name="Shade" Fill="#880C1020" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <Border x:Name="SelectionBorder" BorderBrush="#9B8CFF" BorderThickness="2" Visibility="Collapsed" />
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,28"
                Background="#F217182B" CornerRadius="14" Padding="22,14" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17"
                           Text="Выделите мышью область с текстом" />
                <TextBlock Foreground="#D3D1E7" FontFamily="Segoe UI" FontSize="12" Margin="0,5,0,0"
                           Text="Отпустите кнопку — откроется проверка текста. Esc — отмена." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
