<Window x:Class="UISI_Doc_Constructor.FieldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание поля"
        Width="500"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="23"
                       FontWeight="Bold"
                       Text="Создать поле" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Новое поле получит постоянный внутренний идентификатор. Существующее поле можно повторить в другом месте документа." />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <RadioButton x:Name="NewFieldRadioButton"
                         IsChecked="True"
                         Checked="FieldMode_Changed"
                         Content="Создать новое поле" />
            <TextBlock Margin="0,10,0,5"
                       FontWeight="SemiBold"
                       Text="Название поля" />
            <TextBox x:Name="FieldNameTextBox"
                     MaxLength="100" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <RadioButton x:Name="ExistingFieldRadioButton"
                         Checked="FieldMode_Changed"
                         Content="Повторить существующее поле" />
            <ComboBox x:Name="ExistingFieldsComboBox"
                      Margin="0,10,0,0"
                      IsEnabled="False"
                      DisplayMemberPath="DisplayName" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Content="Отмена" />
            <Button Width="120"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Create_Click"
                    Content="Создать" />
        </StackPanel>
    </Grid>
</Window>
