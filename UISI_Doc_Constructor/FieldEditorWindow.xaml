<Window x:Class="UISI_Doc_Constructor.FieldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Создание поля"
        Style="{StaticResource AppWindowStyle}"
        Width="580"
        Height="570"
        MinWidth="540"
        MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <materialDesign:Card Padding="18"
                             Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Background="#ECE9FF" CornerRadius="15">
                        <materialDesign:PackIcon Width="24"
                                                 Height="24"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#6559E8"
                                                 Kind="PencilOutline" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="Создать поле" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Выделенный в Word текст станет заполняемым полем." />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Padding="12"
                        Background="#F8F7FF"
                        BorderBrush="#E6E2FF"
                        BorderThickness="1"
                        CornerRadius="13">
                    <StackPanel>
                        <RadioButton x:Name="NewFieldRadioButton"
                                     GroupName="FieldCreationMode"
                                     IsChecked="True"
                                     Checked="FieldMode_Changed"
                                     Content="Создать новое поле" />
                        <TextBox x:Name="FieldNameTextBox"
                                 Height="54"
                                 Margin="0,12,0,0"
                                 MaxLength="100"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Название поля"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 TextChanged="FieldNameTextBox_TextChanged" />
                        <Border x:Name="TranslationPairOption"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="#EEF9F6"
                                BorderBrush="#D7F0E9"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <CheckBox x:Name="TranslationPairCheckBox"
                                          FontWeight="SemiBold"
                                          Content="Сразу создать английское поле для переводчика" />
                                <TextBlock Margin="24,5,0,0"
                                           FontSize="10.5"
                                           Foreground="#4F7168"
                                           Text="После украинского поля программа попросит выделить соответствующий текст справа."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Padding="12"
                        Background="#FCFCFE"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <StackPanel>
                        <RadioButton x:Name="ExistingFieldRadioButton"
                                     GroupName="FieldCreationMode"
                                     Checked="FieldMode_Changed"
                                     Content="Повторить существующее поле" />
                        <ComboBox x:Name="ExistingFieldsComboBox"
                                  Height="54"
                                  Margin="0,12,0,0"
                                  IsEnabled="False"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Выберите поле"
                                  SelectionChanged="ExistingFieldsComboBox_SelectionChanged" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="5"
                           Margin="4,8,4,8"
                           VerticalAlignment="Top"
                           FontSize="11"
                           Foreground="#D74242"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="6"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="108"
                            Height="42"
                            Margin="0,0,10,0"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="Cancel_Click"
                            Content="Отмена" />
                    <Button Width="128"
                            Height="42"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Create_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Создать" />
                            <materialDesign:PackIcon Width="17"
                                                     Height="17"
                                                     Margin="8,0,0,0"
                                                     Kind="ArrowRight" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
