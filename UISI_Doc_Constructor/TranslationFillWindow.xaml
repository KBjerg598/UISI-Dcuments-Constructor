<Window x:Class="UISI_Doc_Constructor.TranslationFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Заполнение перевода"
        Style="{StaticResource AppWindowStyle}"
        Width="980"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SelectableSourceTextBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="#3E655A" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#3E655A" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionBrush" Value="#B7E9DC" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#FFF0E4" CornerRadius="18">
                        <materialDesign:PackIcon Width="29"
                                                 Height="29"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#F18A2A"
                                                 Kind="Translate" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="Переведите английские поля" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding TemplateDescription}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="#F1EFFF"
                            CornerRadius="12">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6559E8"
                                   Text="{Binding TargetCountText}" />
                    </Border>
                </Grid>

                <Border Grid.Row="2" Padding="13,10" Background="#F6F5FF" CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,9,0"
                                                 Foreground="#6559E8"
                                                 Kind="ShieldCheckOutline" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="#5F5A82"
                                   Text="Украинский текст доступен только как подсказка. В окончательном DOCX все рамки будут удалены."
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="#F9F9FC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <ScrollViewer Padding="14"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,12"
                                                         Padding="14"
                                                         Background="White"
                                                         UniformCornerRadius="13"
                                                         materialDesign:ElevationAssist.Elevation="Dp0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0B8B68"
                                                           Text="УКРАИНСКИЙ ОРИГИНАЛ" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding SourceDisplayName}" />
                                                <Border Margin="0,8,0,0"
                                                        Padding="11,9"
                                                        MinHeight="58"
                                                        Background="#F0FAF7"
                                                        CornerRadius="9">
                                                    <TextBox AutomationProperties.HelpText="Выделите текст мышью и нажмите Ctrl+C"
                                                             Style="{StaticResource SelectableSourceTextBoxStyle}"
                                                             Text="{Binding SourceValue, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                                             ToolTip="Текст можно выделить и скопировать через Ctrl+C"
                                                             VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                            <materialDesign:PackIcon Grid.Column="1"
                                                                     Width="19"
                                                                     Height="19"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#A3A0B7"
                                                                     Kind="ArrowRight" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#6559E8"
                                                           Text="АНГЛИЙСКИЙ ПЕРЕВОД" />
                                                <TextBox MinHeight="88"
                                                         Margin="0,8,0,0"
                                                         Padding="11,8"
                                                         AcceptsReturn="True"
                                                         MaxLength="12000"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="{Binding DisplayName}"
                                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Margin="4,0,16,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Можно сохранить работу и продолжить на другом компьютере."
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="116"
                                Margin="0,0,10,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="Cancel_Click"
                                Content="Закрыть" />
                        <Button Width="176"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SavePackage_Click"
                                Content="Сохранить пакет" />
                        <Button Width="212"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="GenerateFinal_Click"
                                Content="Создать финальный DOCX" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
