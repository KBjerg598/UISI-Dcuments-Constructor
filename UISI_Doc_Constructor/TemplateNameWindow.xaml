<Window x:Class="UISI_Doc_Constructor.TemplateNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Название шаблона"
        Style="{StaticResource AppWindowStyle}"
        Width="540"
        Height="370"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" Background="#ECE9FF" CornerRadius="17">
                        <materialDesign:PackIcon Width="27"
                                                 Height="27"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#6559E8"
                                                 Kind="FileEditOutline" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Назовите шаблон" />
                        <TextBlock x:Name="DialogDescriptionText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Он будет сохранён в вашей библиотеке документов." />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBox x:Name="TemplateNameTextBox"
                             Height="52"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Название шаблона"
                             materialDesign:TextFieldAssist.HasClearButton="True" />
                    <Border Margin="0,12,0,0"
                            Padding="12,9"
                            Background="#F6F5FF"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17"
                                                     Height="17"
                                                     Margin="0,0,8,0"
                                                     Foreground="#6B5CF1"
                                                     Kind="ShieldCheckOutline" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#66618E"
                                       Text="Исходный DOCX останется без изменений." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="108"
                            Margin="0,0,10,0"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="Cancel_Click"
                            Content="Отмена" />
                    <Button Width="142"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConfirmButtonText"
                                       VerticalAlignment="Center"
                                       Text="Импортировать" />
                            <materialDesign:PackIcon Width="17"
                                                     Height="17"
                                                     Margin="8,0,0,0"
                                                     Kind="ArrowRight" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
