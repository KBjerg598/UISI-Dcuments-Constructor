<Window x:Class="UISI_Doc_Constructor.SavedFillingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Сохранённые заполнения"
        Style="{StaticResource AppWindowStyle}"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#ECE9FF" CornerRadius="18">
                        <materialDesign:PackIcon Width="29"
                                                 Height="29"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#6559E8"
                                                 Kind="History" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="Сохранённые заполнения" />
                        <TextBlock x:Name="CurrentTemplateText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Background="#F1EFFF"
                            CornerRadius="12">
                        <TextBlock x:Name="CountText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#5B50D5" />
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Height="48"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Поиск по названию или шаблону"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             TextChanged="SearchTextBox_TextChanged" />
                    <CheckBox x:Name="OnlyCurrentTemplateCheckBox"
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Checked="Filter_Changed"
                              Unchecked="Filter_Changed"
                              Content="Только текущий шаблон" />
                </Grid>

                <Grid Grid.Row="4">
                    <Border Background="#F9F9FC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ListBox x:Name="FillingsList"
                                 Margin="5"
                                 Padding="3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding Fillings}"
                                 MouseDoubleClick="FillingsList_MouseDoubleClick"
                                 SelectionChanged="FillingsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FieldListItemStyle}">
                                    <Setter Property="Margin" Value="2,2,2,8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="14"
                                                         Background="White"
                                                         UniformCornerRadius="13"
                                                         materialDesign:ElevationAssist.Elevation="Dp0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" Background="#EEEBFF" CornerRadius="12">
                                                <materialDesign:PackIcon Width="20"
                                                                         Height="20"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#6559E8"
                                                                         Kind="TextBoxCheckOutline" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TemplateName, Mode=OneWay}" />
                                                    <Run Text="  •  " />
                                                    <Run Text="{Binding FieldsCountText, Mode=OneWay}" />
                                                    <Run Text="  •  " />
                                                    <Run Text="{Binding LastUsedDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Width="38"
                                                        Height="38"
                                                        Margin="0,0,6,0"
                                                        Padding="0"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="Переименовать"
                                                        AutomationProperties.Name="Переименовать заполнение"
                                                        Click="Rename_Click">
                                                    <materialDesign:PackIcon Width="18" Height="18" Kind="PencilOutline" />
                                                </Button>
                                                <Button Width="38"
                                                        Height="38"
                                                        Padding="0"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="Удалить"
                                                        AutomationProperties.Name="Удалить заполнение"
                                                        Click="Delete_Click">
                                                    <materialDesign:PackIcon Width="18" Height="18" Kind="DeleteOutline" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="58" Height="58" HorizontalAlignment="Center" Background="#EEEBFF" CornerRadius="18">
                            <materialDesign:PackIcon Width="28"
                                                     Height="28"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="#6559E8"
                                                     Kind="DatabaseOffOutline" />
                        </Border>
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Сохранённых заполнений пока нет" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Они появятся после успешного создания документа." />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DeleteAllButton"
                            Width="150"
                            HorizontalAlignment="Left"
                            Style="{StaticResource QuietButtonStyle}"
                            Foreground="#C84848"
                            Click="DeleteAll_Click"
                            Content="Удалить все" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="108"
                                Margin="0,0,10,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="Cancel_Click"
                                Content="Отмена" />
                        <Button x:Name="UseButton"
                                Width="190"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Use_Click"
                                Content="Загрузить заполнение" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
