<Window x:Class="UISI_Doc_Constructor.TranslationPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Английская пара поля"
        Style="{StaticResource AppWindowStyle}"
        Width="620"
        Height="570"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#E8F8F3" CornerRadius="18">
                        <materialDesign:PackIcon Width="29"
                                                 Height="29"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#0DAA7A"
                                                 Kind="Translate" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="Добавьте английскую пару" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Украинское поле уже создано. Отметьте родственное значение справа и выберите режим пары."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Padding="14,12" Background="#F6F5FF" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Background="#6559E8" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="2" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="Выделите соответствующий английский текст в Word" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="#5F5A82"
                                       Text="Выделяйте только изменяемое значение, а не весь абзац. Затем вернитесь к этому небольшому окну."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4">
                    <TextBlock Margin="3,0,0,7"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#0B8B68"
                               Text="СВЯЗАНО С УКРАИНСКИМ ПОЛЕМ" />
                    <TextBlock x:Name="SourceFieldNameText"
                               Margin="3,0,0,13"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TargetFieldNameTextBox"
                             Height="54"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Название английского поля"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             TextChanged="TargetFieldNameTextBox_TextChanged" />
                    <ComboBox x:Name="PairModeComboBox"
                              Height="54"
                              Margin="0,12,0,0"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Как заполнять связанную пару" />
                    <TextBlock x:Name="ValidationText"
                               MinHeight="30"
                               Margin="3,8,3,0"
                               FontSize="11"
                               Foreground="#D74242"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Width="170"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ShowWord_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,7,0" Kind="MicrosoftWord" />
                            <TextBlock VerticalAlignment="Center" Text="Показать Word" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="104"
                                Margin="0,0,10,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="Cancel_Click"
                                Content="Пропустить" />
                        <Button Width="174"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Create_Click"
                                Content="Создать пару" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
