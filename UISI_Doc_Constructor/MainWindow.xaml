<Window x:Class="UISI_Doc_Constructor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="UISI — Конструктор документов"
        Style="{StaticResource AppWindowStyle}"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="12"
                Padding="18"
                Background="{StaticResource SidebarBrush}"
                CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="58"
                            Height="58"
                            Background="#0D0D12"
                            CornerRadius="16">
                        <Image Source="/Assets/uisi-logo.png"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Fant" />
                    </Border>
                    <StackPanel Margin="12,1,0,0">
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="UISI" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#8F92A8"
                                   Text="DOCUMENT STUDIO" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="12,0,0,8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#74778D"
                               Text="РАБОЧЕЕ ПРОСТРАНСТВО" />

                    <Button x:Name="OverviewNavButton"
                            Style="{StaticResource SelectedNavButtonStyle}"
                            Click="OverviewNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="21"
                                                     Height="21"
                                                     Margin="0,0,13,0"
                                                     Kind="ViewDashboardOutline" />
                            <TextBlock VerticalAlignment="Center" Text="Обзор" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TemplatesNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="TemplatesNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Width="21"
                                                     Height="21"
                                                     Margin="0,0,13,0"
                                                     Kind="FileDocumentMultipleOutline" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="Мои шаблоны" />
                            <Border Grid.Column="2"
                                    MinWidth="28"
                                    Padding="7,2"
                                    Background="#2A2B40"
                                    CornerRadius="9">
                                <TextBlock x:Name="TemplatesCountBadgeText"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#AEB0C2"
                                           Text="0" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="ImportNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ImportTemplate_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="21"
                                                     Height="21"
                                                     Margin="0,0,13,0"
                                                     Kind="FilePlusOutline" />
                            <TextBlock VerticalAlignment="Center" Text="Новый шаблон" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FillNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="FillDocument_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="21"
                                                     Height="21"
                                                     Margin="0,0,13,0"
                                                     Kind="FileDocumentEditOutline" />
                            <TextBlock VerticalAlignment="Center" Text="Заполнить документ" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Margin="0,0,0,16"
                            Padding="15"
                            Background="{StaticResource SidebarCardBrush}"
                            CornerRadius="17">
                        <StackPanel>
                            <Border Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Background="#363257"
                                    CornerRadius="11">
                                <materialDesign:PackIcon Width="19"
                                                         Height="19"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#9D91FF"
                                                         Kind="LightbulbOnOutline" />
                            </Border>
                            <TextBlock Margin="0,12,0,4"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="Нужна помощь?" />
                            <TextBlock FontSize="11"
                                       LineHeight="17"
                                       Foreground="#9699AD"
                                       TextWrapping="Wrap"
                                       Text="Три коротких шага — и первый документ будет готов." />
                            <Button MinWidth="0"
                                    Height="34"
                                    Margin="0,8,0,0"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    Foreground="#A99FFF"
                                    Click="ShowHelp_Click"
                                    Content="Открыть инструкцию" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10"
                            Background="#202136"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    Background="#0D0D12"
                                    CornerRadius="12">
                                <Image Source="/Assets/uisi-logo.png"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="Fant" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="Локальный профиль" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="10"
                                           Foreground="#85889E"
                                           Text="Данные хранятся на этом ПК" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20,18,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingText"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Добрый день!" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Продолжим работу с документами?" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBox x:Name="TemplateSearchBox"
                             Width="260"
                             Height="52"
                             Margin="0,0,12,0"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Поиск шаблонов"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             TextChanged="TemplateSearchBox_TextChanged" />
                    <Button Height="46"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ImportTemplate_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="19"
                                                     Height="19"
                                                     Margin="0,0,9,0"
                                                     Kind="Plus" />
                            <TextBlock VerticalAlignment="Center" Text="Новый шаблон" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="DashboardScrollViewer"
                          Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Height="180"
                            Margin="0,0,0,18"
                            Padding="28,20"
                            CornerRadius="24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#5146D8" />
                                <GradientStop Offset="0.58" Color="#7261EF" />
                                <GradientStop Offset="1" Color="#8F78F4" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <Border Height="26"
                                        HorizontalAlignment="Left"
                                        Padding="12,0"
                                        Background="#30FFFFFF"
                                        CornerRadius="10">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="БЫСТРЫЙ СТАРТ" />
                                </Border>
                                <TextBlock Margin="0,10,0,4"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="Создайте документ за пару минут" />
                                <TextBlock FontSize="12"
                                           Foreground="#E8E5FF"
                                           Text="Выберите шаблон, заполните поля — остальное сделает программа." />
                                <Button MinWidth="178"
                                        Height="36"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="White"
                                        BorderBrush="White"
                                        Foreground="#5146D8"
                                        FontWeight="SemiBold"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        Click="FillDocument_Click"
                                        Content="Начать заполнение" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="20,0,6,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Border Width="58"
                                        Height="58"
                                        Background="White"
                                        CornerRadius="18">
                                    <materialDesign:PackIcon Width="28"
                                                             Height="28"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#6559E8"
                                                             Kind="FileDocumentOutline" />
                                </Border>
                                <Border Width="42" Height="2" Margin="12,0" Background="#65FFFFFF" />
                                <Border Width="58"
                                        Height="58"
                                        Background="#2AFFFFFF"
                                        CornerRadius="18">
                                    <materialDesign:PackIcon Width="26"
                                                             Height="26"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="PencilOutline" />
                                </Border>
                                <Border Width="42" Height="2" Margin="12,0" Background="#65FFFFFF" />
                                <Border Width="58"
                                        Height="58"
                                        Background="#2AFFFFFF"
                                        CornerRadius="18">
                                    <materialDesign:PackIcon Width="27"
                                                             Height="27"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="CheckCircleOutline" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card Grid.Column="0"
                                             Height="92"
                                             Padding="18"
                                             Style="{StaticResource DashboardCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="#ECE9FF" CornerRadius="14">
                                    <materialDesign:PackIcon Width="23"
                                                             Height="23"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#6B5CF1"
                                                             Kind="FileDocumentMultipleOutline" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TemplatesCountMetricText"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Text="0" />
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="сохранённых шаблонов" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Column="2"
                                             Height="92"
                                             Padding="18"
                                             Style="{StaticResource DashboardCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="{StaticResource SuccessSoftBrush}" CornerRadius="14">
                                    <materialDesign:PackIcon Width="23"
                                                             Height="23"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource SuccessBrush}"
                                                             Kind="FileEditOutline" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FieldsCountMetricText"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Text="0" />
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="полей в текущем шаблоне" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Column="4"
                                             Height="92"
                                             Padding="18"
                                             Style="{StaticResource DashboardCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="{StaticResource WarningSoftBrush}" CornerRadius="14">
                                    <materialDesign:PackIcon Width="23"
                                                             Height="23"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource WarningBrush}"
                                                             Kind="ClockOutline" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LastUpdatedMetricText"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="—" />
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="последнее изменение" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <Grid x:Name="WorkspaceGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,11">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Мои шаблоны" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="Выберите шаблон для продолжения" />
                            </Grid>

                            <Grid>
                                <ListBox x:Name="TemplatesList"
                                         MinHeight="280"
                                         MaxHeight="430"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource TemplateListItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="TemplatesList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Padding="16"
                                                                 Style="{StaticResource DashboardCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border Width="48"
                                                            Height="48"
                                                            Grid.RowSpan="2"
                                                            VerticalAlignment="Top"
                                                            Background="#ECE9FF"
                                                            CornerRadius="14">
                                                        <materialDesign:PackIcon Width="24"
                                                                                 Height="24"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#6B5CF1"
                                                                                 Kind="FileEditOutline" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="14,1,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                        <Grid Margin="0,5,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding FieldCountText}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="8,0"
                                                                       FontSize="11"
                                                                       Foreground="#C4C5CF"
                                                                       Text="•" />
                                                            <TextBlock Grid.Column="2"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding UpdatedAtDisplay}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="14,10,0,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                        <Button Width="38"
                                                                Height="38"
                                                                Margin="0,0,8,0"
                                                                Padding="0"
                                                                Style="{StaticResource QuietButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="Переименовать шаблон"
                                                                AutomationProperties.Name="Переименовать шаблон"
                                                                Click="RenameTemplateFromCard_Click">
                                                            <materialDesign:PackIcon Width="18"
                                                                                     Height="18"
                                                                                     Kind="PencilOutline" />
                                                        </Button>
                                                        <Button Width="38"
                                                                Height="38"
                                                                Margin="0,0,8,0"
                                                                Padding="0"
                                                                Style="{StaticResource QuietButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="Экспортировать шаблон"
                                                                AutomationProperties.Name="Экспортировать шаблон"
                                                                Click="ExportTemplateFromCard_Click">
                                                            <materialDesign:PackIcon Width="18"
                                                                                     Height="18"
                                                                                     Kind="ExportVariant" />
                                                        </Button>
                                                        <Button Width="38"
                                                                Height="38"
                                                                Margin="0,0,8,0"
                                                                Padding="0"
                                                                Style="{StaticResource QuietButtonStyle}"
                                                                Foreground="#C64A4A"
                                                                Tag="{Binding}"
                                                                ToolTip="Удалить шаблон"
                                                                AutomationProperties.Name="Удалить шаблон"
                                                                Click="DeleteTemplateFromCard_Click">
                                                            <materialDesign:PackIcon Width="18"
                                                                                     Height="18"
                                                                                     Kind="DeleteOutline" />
                                                        </Button>
                                                        <Button Height="38"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Tag="{Binding}"
                                                                Click="OpenTemplateFromCard_Click"
                                                                Content="Открыть" />
                                                        <Button Height="38"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Tag="{Binding}"
                                                                Click="FillTemplateFromCard_Click"
                                                                Content="Заполнить" />
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <materialDesign:Card x:Name="EmptyTemplatesPanel"
                                                     MinHeight="280"
                                                     Padding="34"
                                                     Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="66" Height="66" Background="#ECE9FF" CornerRadius="22">
                                            <materialDesign:PackIcon Width="31"
                                                                     Height="31"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#6B5CF1"
                                                                     Kind="FilePlusOutline" />
                                        </Border>
                                        <TextBlock x:Name="EmptyTemplatesTitleText"
                                                   Margin="0,16,0,5"
                                                   HorizontalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="Добавьте первый шаблон" />
                                        <TextBlock x:Name="EmptyTemplatesDescriptionText"
                                                   MaxWidth="360"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Импортируйте документ DOCX, назовите его — и он останется в библиотеке программы." />
                                        <Button Margin="0,18,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ImportTemplate_Click"
                                                Content="Импортировать DOCX" />
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,11"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Текущий шаблон" />

                            <materialDesign:Card MinHeight="365"
                                                 Padding="20"
                                                 Style="{StaticResource DashboardCardStyle}">
                                <Grid>
                                    <StackPanel x:Name="CurrentTemplateEmptyPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="62" Height="62" Background="#F0EEFF" CornerRadius="20">
                                            <materialDesign:PackIcon Width="30"
                                                                     Height="30"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#7164E9"
                                                                     Kind="FolderOpenOutline" />
                                        </Border>
                                        <TextBlock Margin="0,15,0,5"
                                                   HorizontalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="Шаблон не выбран" />
                                        <TextBlock MaxWidth="260"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Выберите сохранённый шаблон слева или импортируйте новый." />
                                    </StackPanel>

                                    <Grid x:Name="CurrentTemplatePanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Padding="14"
                                                Background="#F0EDFF"
                                                CornerRadius="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Width="44"
                                                        Height="44"
                                                        Grid.RowSpan="2"
                                                        VerticalAlignment="Top"
                                                        Background="#6658EB"
                                                        CornerRadius="14">
                                                    <materialDesign:PackIcon Width="23"
                                                                             Height="23"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="White"
                                                                             Kind="FileEditOutline" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#6559E8"
                                                               Text="АКТИВНЫЙ ШАБЛОН" />
                                                    <TextBlock x:Name="TemplateNameText"
                                                               Margin="0,3,0,0"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="12,7,0,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button Width="36"
                                                            Height="36"
                                                            Margin="0,0,3,0"
                                                            Padding="0"
                                                            Style="{StaticResource QuietButtonStyle}"
                                                            ToolTip="Экспортировать шаблон"
                                                            AutomationProperties.Name="Экспортировать шаблон"
                                                            Click="ExportCurrentTemplate_Click">
                                                        <materialDesign:PackIcon Width="18"
                                                                                 Height="18"
                                                                                 Kind="ExportVariant" />
                                                    </Button>
                                                    <Button Width="36"
                                                            Height="36"
                                                            Margin="0,0,3,0"
                                                            Padding="0"
                                                            Style="{StaticResource QuietButtonStyle}"
                                                            ToolTip="Переименовать шаблон"
                                                            AutomationProperties.Name="Переименовать шаблон"
                                                            Click="RenameCurrentTemplate_Click">
                                                        <materialDesign:PackIcon Width="18"
                                                                                 Height="18"
                                                                                 Kind="PencilOutline" />
                                                    </Button>
                                                    <Button Width="36"
                                                            Height="36"
                                                            Padding="0"
                                                            Style="{StaticResource QuietButtonStyle}"
                                                            Foreground="#C64A4A"
                                                            ToolTip="Удалить шаблон"
                                                            AutomationProperties.Name="Удалить шаблон"
                                                            Click="DeleteCurrentTemplate_Click">
                                                        <materialDesign:PackIcon Width="18"
                                                                                 Height="18"
                                                                                 Kind="DeleteOutline" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="0,16,0,13">
                                            <Grid>
                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Text="Готовность шаблона" />
                                                <TextBlock x:Name="CurrentProgressText"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Text="40%" />
                                            </Grid>
                                            <TextBlock x:Name="CurrentTemplateHintText"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="Откройте шаблон в Word и добавьте поля." />
                                            <ProgressBar x:Name="CurrentProgressBar"
                                                         Height="7"
                                                         Margin="0,12,0,0"
                                                         Maximum="100"
                                                         Value="40"
                                                         Style="{StaticResource MaterialDesignLinearProgressBar}" />
                                            <TextBlock x:Name="TemplatePathText"
                                                       Margin="0,12,0,0"
                                                       FontSize="10"
                                                       Foreground="#999BAA"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="OpenWordButton"
                                                    Height="38"
                                                    Padding="8,6"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="OpenInWord_Click"
                                                    Content="Открыть в Word" />
                                            <Button x:Name="CreateFieldButton"
                                                    Grid.Column="2"
                                                    Height="38"
                                                    Padding="8,6"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="CreateField_Click"
                                                    Content="Создать поле" />
                                            <Button x:Name="RefreshFieldsButton"
                                                    Grid.Column="4"
                                                    Width="38"
                                                    Height="38"
                                                    Padding="0"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    IsEnabled="False"
                                                    ToolTip="Обновить поля"
                                                    Click="RefreshFields_Click">
                                                <materialDesign:PackIcon Width="20" Height="20" Kind="Refresh" />
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="Поля документа" />
                                                <TextBlock x:Name="FieldsSummaryText"
                                                           HorizontalAlignment="Right"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="Поля пока не созданы" />
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,0,0,7"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Перетаскивайте поля за маркер, чтобы менять порядок"
                                                       TextTrimming="CharacterEllipsis" />

                                            <ListBox x:Name="FieldsList"
                                                     Grid.Row="2"
                                                     MinHeight="126"
                                                     MaxHeight="300"
                                                     Padding="4"
                                                     Background="#FAFAFD"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1"
                                                     AllowDrop="True"
                                                     ItemContainerStyle="{StaticResource FieldListItemStyle}"
                                                     SelectionChanged="FieldsList_SelectionChanged"
                                                     PreviewMouseLeftButtonDown="FieldsList_PreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="FieldsList_PreviewMouseMove"
                                                     PreviewKeyDown="FieldsList_PreviewKeyDown"
                                                     DragOver="FieldsList_DragOver"
                                                     DragLeave="FieldsList_DragLeave"
                                                     Drop="FieldsList_Drop"
                                                     MouseDoubleClick="FieldsList_MouseDoubleClick"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="38">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Width="18"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="#A09CB8"
                                                                       Cursor="SizeNS"
                                                                       Text="⋮⋮"
                                                                       ToolTip="Перетащить поле"
                                                                       AutomationProperties.Name="Маркер перемещения поля" />
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="7,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding DisplayName}" />
                                                                <TextBlock Margin="0,1,0,0"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           Text="{Binding OccurrencesText}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Width="30"
                                                                    Height="30"
                                                                    Margin="0,0,2,0"
                                                                    Padding="0"
                                                                    Style="{StaticResource QuietButtonStyle}"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Переименовать поле"
                                                                    AutomationProperties.Name="Переименовать поле"
                                                                    Click="RenameField_Click">
                                                                <materialDesign:PackIcon Width="16"
                                                                                         Height="16"
                                                                                         Kind="PencilOutline" />
                                                            </Button>
                                                            <Button Grid.Column="3"
                                                                    Width="30"
                                                                    Height="30"
                                                                    Padding="0"
                                                                    Style="{StaticResource QuietButtonStyle}"
                                                                    Foreground="#C64A4A"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Удалить поле"
                                                                    AutomationProperties.Name="Удалить поле"
                                                                    Click="DeleteField_Click">
                                                                <materialDesign:PackIcon Width="16"
                                                                                         Height="16"
                                                                                         Kind="DeleteOutline" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>

                                        <Button x:Name="FillDocumentButton"
                                                Grid.Row="4"
                                                Height="44"
                                                Margin="0,15,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="False"
                                                Click="FillDocument_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Заполнить документ" />
                                                <materialDesign:PackIcon Width="18"
                                                                         Height="18"
                                                                         Margin="10,0,0,0"
                                                                         Kind="ArrowRight" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="4"
                    Padding="14,10"
                    Background="#EBE9FF"
                    CornerRadius="11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" Background="#D9D4FF" CornerRadius="9">
                        <materialDesign:PackIcon Width="16"
                                                 Height="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#584CD4"
                                                 Kind="ShieldCheckOutline" />
                    </Border>
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#5148A9"
                               Text="Готово к работе. Импортируйте или выберите документ DOCX." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
