<Window x:Class="UISI_Doc_Constructor.DocumentFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UISI_Doc_Constructor"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Заполнение документа"
        Style="{StaticResource AppWindowStyle}"
        Width="880"
        Height="780"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="TranslationToolbarSpacing" Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#ECE9FF" CornerRadius="18">
                        <materialDesign:PackIcon Width="29"
                                                 Height="29"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#6559E8"
                                                 Kind="FileDocumentEditOutline" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="Заполните документ" />
                        <TextBlock x:Name="FillWindowDescription"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Значения используются только для создания выбранного файла." />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Height="42"
                            Margin="14,0,0,0"
                            Padding="14,7"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Загрузить ранее сохранённые значения"
                            Click="LoadSavedFilling_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18"
                                                     Height="18"
                                                     Margin="0,0,8,0"
                                                     Kind="History" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="Загрузить заполнение" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="TranslationToolbar"
                        Grid.Row="2"
                        Padding="12,9"
                        Background="#F6F5FF"
                        CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Width="18"
                                                     Height="18"
                                                     Margin="0,0,8,0"
                                                     Foreground="#6559E8"
                                                     Kind="Translate" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#5F5A82"
                                       Text="Одинаковые пары заполнятся сразу; остальные английские поля останутся переводчику."
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Button Grid.Column="1"
                                Height="38"
                                Margin="12,0,8,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="ConfigureTranslation_Click"
                                Content="Настроить языки" />
                        <Button Grid.Column="2"
                                Height="38"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PrepareTranslation_Click"
                                Content="Подготовить для перевода" />
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Padding="16"
                        Background="#F9F9FC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,12"
                                                         Padding="14"
                                                         Background="White"
                                                         UniformCornerRadius="12"
                                                         materialDesign:ElevationAssist.Elevation="Dp0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" Background="#EEEBFF" CornerRadius="10">
                                                <materialDesign:PackIcon Width="17"
                                                                         Height="17"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#6559E8"
                                                                         Kind="PencilOutline" />
                                            </Border>
                                            <TextBox Grid.Column="1"
                                                     Height="52"
                                                     Margin="10,0,0,0"
                                                     VerticalContentAlignment="Center"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     materialDesign:HintAssist.Hint="{Binding DisplayName}"
                                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <local:FieldCopyButton Grid.Column="2"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FieldName="{Binding DisplayName, Mode=OneWay}"
                                                                   Text="{Binding Value, Mode=OneWay}" />
                                            <local:FieldOcrButton Grid.Column="3"
                                                                  VerticalAlignment="Center"
                                                                  FieldName="{Binding DisplayName}"
                                                                  Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="4"
                                                       Margin="10,0,2,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6559E8"
                                                       Text="{Binding TranslationRoleText}" />
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"
                                                 Foreground="{StaticResource SuccessBrush}"
                                                 Kind="ShieldCheckOutline" />
                        <TextBlock x:Name="SavedDataStatusText"
                                   MaxWidth="330"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Данные сохраняются локально только после создания документа"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="108"
                                Margin="0,0,10,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="Cancel_Click"
                                Content="Отмена" />
                        <Button Width="218"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Generate_Click">
                            <TextBlock VerticalAlignment="Center"
                                       Text="Сформировать документ" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
