<Window x:Class="UISI_Doc_Constructor.TranslationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Настройка двуязычного шаблона"
        Style="{StaticResource AppWindowStyle}"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#E8F8F3" CornerRadius="18">
                        <materialDesign:PackIcon Width="29"
                                                 Height="29"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#0DAA7A"
                                                 Kind="Translate" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="Настройте языки полей" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Украинские значения заполняет автор, английские — переводчик, общие переносятся сразу." />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Padding="13,10" Background="#F6F5FF" CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,9,0"
                                                 Foreground="#6559E8"
                                                 Kind="InformationOutline" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="#5F5A82"
                                   Text="Свяжите английское поле с украинским оригиналом и выберите: переводить его или подставлять одинаковое значение в обе стороны."
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="12,9"
                                Background="{StaticResource SuccessSoftBrush}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32"
                                        Background="{StaticResource SuccessBrush}"
                                        CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="UA" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Украинские поля" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="#4F7168"
                                               Text="Заполняет автор" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="12,9"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32"
                                        Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="EN" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Английские поля" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="#5F5A82"
                                               Text="Заполняет переводчик" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="4"
                                Padding="12,9"
                                Background="{StaticResource WarningSoftBrush}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32"
                                        Background="{StaticResource WarningBrush}"
                                        CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="=" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Общее поле" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="#805A35"
                                               Text="Без языковой пары" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="6"
                        Background="#F9F9FC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <ScrollViewer Padding="14"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,6,0,8"
                                                    Padding="11,7"
                                                    Background="#ECE9FF"
                                                    CornerRadius="9">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="4"
                                                            Height="18"
                                                            Margin="0,0,9,0"
                                                            Background="{StaticResource PrimaryBrush}"
                                                            CornerRadius="2" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#5148A9"
                                                               Text="{Binding Name}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,10"
                                                         Padding="13"
                                                         Background="White"
                                                         UniformCornerRadius="12"
                                                         materialDesign:ElevationAssist.Elevation="Dp0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.05*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="3,0,14,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="ПОЛЕ ШАБЛОНА" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      Height="52"
                                                      Margin="0,0,12,0"
                                                      ItemsSource="{Binding RoleOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Role"
                                                      SelectedValue="{Binding Role, Mode=TwoWay}"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      materialDesign:HintAssist.Hint="Роль поля" />
                                            <Border x:Name="RoleExplanation"
                                                    Grid.Column="2"
                                                    Grid.ColumnSpan="2"
                                                    MinHeight="52"
                                                    Padding="13,8"
                                                    VerticalAlignment="Center"
                                                    Background="#F7F7FA"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding RoleDescription}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <ComboBox x:Name="SourceSelector"
                                                      Grid.Column="2"
                                                      Height="52"
                                                      Margin="0,0,10,0"
                                                      ItemsSource="{Binding SourceOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding SourceFieldTag, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanSelectSource}"
                                                      Visibility="Collapsed"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      materialDesign:HintAssist.Hint="Украинский оригинал" />
                                            <ComboBox x:Name="PairModeSelector"
                                                      Grid.Column="3"
                                                      Height="52"
                                                      ItemsSource="{Binding PairModeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Mode"
                                                      SelectedValue="{Binding PairMode, Mode=TwoWay}"
                                                      Visibility="Collapsed"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      materialDesign:HintAssist.Hint="Как заполнить пару" />
                                        </Grid>
                                    </materialDesign:Card>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CanSelectSource}" Value="True">
                                            <Setter TargetName="RoleExplanation"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                            <Setter TargetName="SourceSelector"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                            <Setter TargetName="PairModeSelector"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ValidationText"
                               Margin="4,0,16,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#D74242"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="108"
                                Margin="0,0,10,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="Cancel_Click"
                                Content="Отмена" />
                        <Button Width="190"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Save_Click"
                                Content="Сохранить настройку" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
