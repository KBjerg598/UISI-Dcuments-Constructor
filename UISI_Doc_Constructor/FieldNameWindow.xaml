<Window x:Class="UISI_Doc_Constructor.FieldNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Редактирование поля"
        Style="{StaticResource AppWindowStyle}"
        Width="540"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" Background="#ECE9FF" CornerRadius="17">
                        <materialDesign:PackIcon Width="27"
                                                 Height="27"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#6559E8"
                                                 Kind="FormTextbox" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Название поля" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Новое название применится ко всем вхождениям в документе." />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBox x:Name="FieldNameTextBox"
                             Height="58"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Название поля"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             TextChanged="FieldNameTextBox_TextChanged" />
                    <TextBlock x:Name="ValidationText"
                               MinHeight="18"
                               Margin="4,7,4,0"
                               FontSize="11"
                               Foreground="#D74242"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="4"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="108"
                            Margin="0,0,10,0"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="Cancel_Click"
                            Content="Отмена" />
                    <Button Width="132"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"
                            Content="Сохранить" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
