<Window x:Class="UISI_Doc_Constructor.SavedFillingMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Сопоставление полей"
        Style="{StaticResource AppWindowStyle}"
        Width="900"
        Height="720"
        MinWidth="780"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <materialDesign:Card Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#FFF0E4" CornerRadius="18">
                        <materialDesign:PackIcon Width="29"
                                                 Height="29"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="#E57B20"
                                                 Kind="AlertCircleOutline" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Text="Проверьте несовпадающие поля" />
                        <TextBlock x:Name="DescriptionText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="13,10" Background="#EAF8F3" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="#258366" Text="СОВПАЛО АВТОМАТИЧЕСКИ" />
                            <TextBlock x:Name="AutomaticCountText" Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="13,10" Background="#FFF4EA" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="#B96821" Text="НУЖНО ПРОВЕРИТЬ" />
                            <TextBlock x:Name="ManualCountText" Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Padding="13,10" Background="#F2F1F8" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="#73758A" Text="ОСТАНЕТСЯ ПУСТЫМ" />
                            <TextBlock x:Name="EmptyCountText" Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4"
                        Padding="14"
                        Background="#F9F9FC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Mappings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,12"
                                                         Padding="14"
                                                         Background="White"
                                                         UniformCornerRadius="12"
                                                         materialDesign:ElevationAssist.Elevation="Dp0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="СОХРАНЁННОЕ ПОЛЕ" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Source.DisplayName}" />
                                                <Border Margin="0,7,0,0" Padding="9,6" Background="#F6F5FB" CornerRadius="8">
                                                    <TextBlock FontSize="11"
                                                               Foreground="#555668"
                                                               Text="{Binding ValuePreview}"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                            <materialDesign:PackIcon Grid.Column="1"
                                                                     Width="18"
                                                                     Height="18"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#A3A0B7"
                                                                     Kind="ArrowRight" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox Height="52"
                                                          ItemsSource="{Binding TargetOptions}"
                                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                          DisplayMemberPath="Label"
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                          materialDesign:HintAssist.Hint="Поле текущего шаблона" />
                                                <TextBlock Margin="3,6,3,0"
                                                           MinHeight="16"
                                                           FontSize="10"
                                                           Foreground="#8B6BD9"
                                                           Text="{Binding SuggestionText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="6" Padding="12,9" Background="#F6F5FF" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="0,0,9,0"
                                                 Foreground="#6559E8"
                                                 Kind="InformationOutline" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="11"
                                       Foreground="#5F5A82"
                                       Text="Значения с вариантом «Не использовать» не будут вставлены." />
                            <TextBlock x:Name="EmptyFieldsText"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ValidationText"
                               Grid.Column="0"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#D74242"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="108"
                                Margin="0,0,10,0"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="Cancel_Click"
                                Content="Отмена" />
                        <Button Width="220"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Apply_Click"
                                Content="Применить заполнение" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
