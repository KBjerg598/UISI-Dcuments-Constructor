<Window x:Class="UISI_Doc_Constructor.OcrReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Распознавание с экрана" Style="{StaticResource AppWindowStyle}"
        Width="1100" Height="760" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="OcrWordButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource PrimarySoftBrush}">
                <materialDesign:PackIcon Kind="TextRecognition" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                <TextBlock FontSize="23" FontWeight="SemiBold" Text="Снимок → текст" />
                <TextBlock x:Name="FieldLabel" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="2" Background="{StaticResource SuccessSoftBrush}" CornerRadius="12" Padding="13,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="17" Height="17" Foreground="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                    <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="11" Text="Локально · без интернета" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="11" Padding="13,10" Margin="0,16,0,12">
            <TextBlock Foreground="#5F5A82" FontSize="12" TextWrapping="Wrap"
                       Text="Нажмите на лишние слова, чтобы исключить их. Или замажьте область и распознайте заново. Справа проверьте и исправьте результат." />
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <WrapPanel x:Name="ImageTools" VerticalAlignment="Center">
                <RadioButton x:Name="WordsTool" GroupName="ImageTool" IsChecked="True" Content="Слова" Margin="0,0,15,0" Checked="Tool_Changed" />
                <RadioButton x:Name="MaskTool" GroupName="ImageTool" Content="Замазать" Margin="0,0,12,0" Checked="Tool_Changed" />
                <Button x:Name="UndoMaskButton" Style="{StaticResource QuietButtonStyle}" Content="Отменить маску" Click="UndoMask_Click" IsEnabled="False" />
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="LanguageBox" Width="162" Margin="0,0,10,0" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="UA + RU + EN" Tag="auto" /><ComboBoxItem Content="Украинский" Tag="ukr" />
                    <ComboBoxItem Content="Русский" Tag="rus" /><ComboBoxItem Content="Английский" Tag="eng" />
                </ComboBox>
                <Button x:Name="RecognizeButton" Style="{StaticResource SecondaryButtonStyle}" Content="Распознать заново" Click="Recognize_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="ВЫБРАННЫЙ ФРАГМЕНТ" Margin="0,0,0,12" />
                    <ScrollViewer x:Name="ImageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F6F7FB">
                        <Grid x:Name="PictureSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White">
                            <Grid.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" /></Grid.LayoutTransform>
                            <Image x:Name="PreviewImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="OverlayCanvas" Background="Transparent" MouseLeftButtonDown="Mask_MouseDown"
                                    MouseMove="Mask_MouseMove" MouseLeftButtonUp="Mask_MouseUp" />
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Масштаб" />
                        <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="10" Maximum="300" Value="100" Margin="12,0" ValueChanged="Zoom_Changed" />
                        <Button Grid.Column="2" Style="{StaticResource QuietButtonStyle}" Padding="9,4" Content="Вместить" Click="Fit_Click" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="ТЕКСТ ДЛЯ ВСТАВКИ" Margin="0,0,0,12" />
                    <TextBox x:Name="ResultBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             VerticalContentAlignment="Top" materialDesign:HintAssist.Hint="Проверьте текст"
                             TextChanged="Result_TextChanged" AutomationProperties.Name="Распознанный текст" />
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Text="Распознавание может ошибаться. Проверьте имена, даты и номера перед вставкой." />
                        <ProgressBar x:Name="BusyBar" Margin="0,10,0,0" Height="3" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,12,0" TextWrapping="Wrap"
                       Text="Снимок не сохраняется. Исходное поле не изменится до подтверждения." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource QuietButtonStyle}" Content="Отмена" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="AppendButton" Style="{StaticResource SecondaryButtonStyle}" Content="Добавить к текущему" Margin="0,0,10,0" Click="Append_Click" IsEnabled="False" />
                <Button x:Name="ReplaceButton" Style="{StaticResource PrimaryButtonStyle}" Content="Вставить в поле" Click="Replace_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
