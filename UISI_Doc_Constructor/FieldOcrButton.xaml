<UserControl x:Class="UISI_Doc_Constructor.FieldOcrButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Focusable="False">
    <Button x:Name="CaptureButton" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="0"
            Style="{StaticResource QuietButtonStyle}" ToolTip="Распознать текст с экрана · локально"
            Click="CaptureButton_Click">
        <materialDesign:PackIcon Width="19" Height="19" Kind="TextRecognition"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Button>
</UserControl>
